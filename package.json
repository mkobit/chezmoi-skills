{
  "name": "chezmoi-skills",
  "version": "0.0.1",
  "scripts": {
    "validate": "bun run scripts/validate.ts --claude-plugin-dir=.claude-plugin",
    "test:contracts": "bun run scripts/test-contracts.ts",
    "test": "bun test",
    "extract:evals": "bun run scripts/extract-transcript-evals.ts",
    "eval": "NODE_OPTIONS=\"-r ./scripts/patch-version.cjs\" bunx promptfoo eval -o eval_results/results.json -o eval_results/index.html",
    "record:benchmark": "bun run scripts/record-benchmark-metrics.ts",
    "generate:history": "bun run scripts/generate-history-index.ts",
    "lint:md": "markdownlint-cli2",
    "lint:spelling": "bun run --bun node_modules/cspell/bin.mjs \"**/*.md\"",
    "lint:eslint": "eslint .",
    "lint:json": "eslint \"**/*.json\" \"**/*.jsonc\"",
    "lint:yaml": "eslint \"**/*.yaml\" \"**/*.yml\""
  },
  "dependencies": {
    "commander": "15.0.0",
    "gray-matter": "4.0.3",
    "remeda": "2.45.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "cspell": "^10.1.1",
    "eslint": "^10.9.1",
    "eslint-plugin-jsonc": "^3.4.2",
    "eslint-plugin-yml": "^3.8.1",
    "gpt-tokenizer": "^4.0.0",
    "markdownlint-cli2": "0.23.2"
  }
}
