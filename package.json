{
  "name": "chezmoi-skills",
  "version": "0.0.1",
  "scripts": {
    "validate": "bun run scripts/skills/validate/index.ts --claude-plugin-dir=.claude-plugin",
    "test:contracts": "bun run scripts/evals/test-contracts.ts",
    "test": "bun test",
    "extract:evals": "bun run scripts/evals/extract-transcript-evals.ts",
    "eval:validate": "bun run scripts/evals/cli.ts validate",
    "eval:local": "bun run scripts/evals/cli.ts run",
    "lint:md": "markdownlint-cli2",
    "lint:spelling": "bun run --bun node_modules/cspell/bin.mjs \"**/*.md\"",
    "fmt": "bun fmt",
    "fmt:check": "bun fmt --check",
    "typecheck": "bun check"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "commander": "15.1.0",
    "cspell": "^10.5.1",
    "gpt-tokenizer": "^4.1.2",
    "gray-matter": "4.0.3",
    "markdownlint-cli2": "0.24.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  }
}
