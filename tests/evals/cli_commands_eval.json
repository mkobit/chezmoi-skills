  {
    "id": "TC-CMD-001",
    "name": "Command generation with dry-run and verbose flags",
    "eval_type": "command_correctness",
    "target_skill": "chezmoi-cli-commands",
    "input": {
      "user_prompt": "How do I preview what changes chezmoi apply would make without writing files to disk?"
    },
    "expected": {
      "exact_command": "chezmoi apply --dry-run",
      "command_regex": "^chezmoi apply (?:--dry-run|-n|--verbose|-v|\\s)+$",
      "required_flags": [
        "--dry-run"
      ]
    },
    "token_budget": 1200
  },
  {
    "id": "TC-CLI-CMD-001",
    "name": "Command generation for diffing changes with exclusion flag",
    "eval_type": "command_correctness",
    "target_skill": "chezmoi-cli-commands",
    "input": {
      "user_prompt": "How do I view diffs between my chezmoi source state and destination files without running scripts?"
